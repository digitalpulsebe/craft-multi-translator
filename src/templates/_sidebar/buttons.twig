{% import '_includes/forms.twig' as forms %}

{% if currentUser.can('multiTranslateContent') %}

    {% do view.registerAssetBundle("digitalpulsebe\\craftmultitranslator\\assets\\MultiTranslatorBundle") %}
    {% set settings = craft.multiTranslator.providerSettings %}

    <fieldset>
        <legend class="h6">{{ 'Multi Translator'|t('multi-translator') }}</legend>
        <div class="meta">
            {% if element.id != element.canonicalId %}
                <div class="warning">{{ 'Warning: revision changes will apply on top of the translated Entry'|t('multi-translator') }}</div>
            {% endif %}

            {% set elementHelper = craft.multiTranslator.getElementHelper() %}

            {% set existingSiteIds = elementHelper.siteStatusesForElement(element)|keys %}
            {% set supportedSiteIds = elementHelper.supportedSitesForElement(element, true)|map(site => site.siteId) %}
            {% set sites = craft.app.sites.allSites %}

            {% set currentDescription = "#{element.site.name} (#{element.site.language})" %}

            {% if settings.translationDirectionButtons in ['fromThis', 'both'] %}
                <div class="field">
                    <div class="heading">
                        {{ 'Translate from'|t('multi-translator') }}
                    </div>
                    <div class="input">
                        <label>{{ currentDescription }}</label>
                    </div>
                </div>

                <div class="field">
                    <div class="heading">
                        {{ 'to:'|t('multi-translator') }}
                    </div>
                    <div class="input">
                        <button type="button" class="btn menubtn" aria-label="{{ 'Translate'|t('multi-translator') }}">{{ 'select target'|t('multi-translator') }}</button>
                        <div class="menu">
                            <ul>
                                <li>
                                    <a href="{{ actionUrl('multi-translator/sidebar/translate-to-all', {
                                        'elementId': element.canonicalId,
                                        'elementType': className(element),
                                        'sourceSiteId': element.siteId
                                    }) }}"
                                       onclick="return confirm('{{ 'Translate to all sites? Confirm your action.'|t('multi-translator')|e('js') }}')"
                                    >
                                        <strong>{{ 'All sites'|t('multi-translator') }}</strong>
                                    </a>
                                </li>
                                {% for site in sites %}
                                    {% if currentUser.can('editSite:'~site.uid) %}
                                        {% if site.id in supportedSiteIds %}
                                            <li>
                                                <a class=""
                                                   href="{{ actionUrl('multi-translator/sidebar/translate', {
                                                       'elementId': element.canonicalId,
                                                       'elementType': className(element),
                                                       'sourceSiteId': element.siteId,
                                                       'targetSiteId': site.id
                                                   }) }}">
                                                    {{ site.name }} ({{ site.locale }})
                                                    {%- if element.siteId == site.id %} {{ '(self)'|t('multi-translator') }}{% endif %}
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if settings.translationDirectionButtons in ['toThis', 'both'] %}
                {% if existingSiteIds|length > 1 %}
                    <div class="field">
                        <div class="heading">
                            {{ 'Translate from:'|t('multi-translator') }}
                        </div>
                        <div class="input">
                            <button type="button" class="btn menubtn" aria-label="{{ 'Translate'|t('multi-translator') }}">{{ 'select source'|t('multi-translator') }}</button>
                            <div class="menu">
                                <ul>
                                    {% for site in sites %}
                                        {% if site.id in existingSiteIds and currentUser.can('editSite:'~site.uid) %}
                                            <li>
                                                <a class=""
                                                   href="{{ actionUrl('multi-translator/sidebar/translate', {
                                                       'elementId': element.canonicalId,
                                                       'elementType': className(element),
                                                       'sourceSiteId': site.id,
                                                       'targetSiteId': element.siteId
                                                   }) }}">
                                                    {{ site.name }} ({{ site.locale }})
                                                    {%- if element.siteId == site.id %} {{ '(self)'|t('multi-translator') }}{% endif %}
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <div class="heading">
                            {{ 'to'|t('multi-translator') }}
                        </div>
                        <div class="input">
                            <label>{{ currentDescription }}</label>
                        </div>
                    </div>
                {% else %}
                    <div class="field" style="border-block-start-width: 2px;">
                        <div class="heading">
                            {{ 'This entry has no other translations yet.'|t('multi-translator') }}
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            <div class="field" style="border-block-start-width: 2px;">
                <div class="input">
                    <div class="heading">
                        <a href="{{ url('multi-translator/translate/review', {
                            'elementId': element.canonicalId,
                            'elementType': className(element),
                            'sourceSiteId': element.siteId,
                        }) }}">
                            <span aria-hidden="true" data-icon="gear"></span>
                            {{ 'More options...'|t('multi-translator') }}
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </fieldset>
{% endif %}
