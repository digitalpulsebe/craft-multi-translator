{% import '_includes/forms.twig' as forms %}

{% if currentUser.can('multiTranslateContent') %}

    {% do view.registerAssetBundle("digitalpulsebe\\craftmultitranslator\\assets\\MultiTranslatorBundle") %}
    {% set settings = craft.multiTranslator.providerSettings %}
    {% set hasUnappliedDrafts = settings.saveAsDraft and craft.multiTranslator.hasUnappliedDrafts(element) %}

    <fieldset>
        <legend class="h6">{{ 'Multi Translator'|t('multi-translator') }}</legend>
        <div class="meta">
            {% if element.id != element.canonicalId %}
                <div class="readable">
                    <blockquote class="note warning">{{ 'Warning: revision changes will apply on top of the translated Entry'|t('multi-translator') }}</blockquote>
                </div>
            {% endif %}

            {% if hasUnappliedDrafts %}
                <div class="readable">
                    <blockquote class="note warning">
                        <p>{{ 'There are unapplied drafts for this entry. Craft drafts contain content for all sites, so applying one may overwrite changes on other sites. Apply or discard these drafts before creating another translated draft.'|t('multi-translator') }}</p>
                    </blockquote>
                </div>
            {% endif %}

            {% set elementHelper = craft.multiTranslator.getElementHelper() %}

            {% set targetSitesService = craft.multiTranslator.targetSites %}
            {% set existingSiteIds = elementHelper.siteStatusesForElement(element)|keys %}
            {% set sites = craft.app.sites.allSites %}
            {% set isDraftTranslation = settings.saveAsDraft and element is instance of('craft\\elements\\Entry') %}

            {% set currentDescription = "#{element.site.name} (#{element.site.language})" %}

            {% if settings.translationDirectionButtons in ['fromThis', 'both'] %}
                <div class="field">
                    <div class="heading">
                        {{ 'Translate from'|t('multi-translator') }}
                    </div>
                    <div class="input">
                        <label>{{ currentDescription }}</label>
                    </div>
                </div>

                <div class="field">
                    <div class="heading">
                        {{ 'to:'|t('multi-translator') }}
                    </div>
                    <div class="input">
                        <button type="button" class="btn menubtn" aria-label="{{ 'Translate'|t('multi-translator') }}">{{ 'select target'|t('multi-translator') }}</button>
                        <div class="menu">
                            {% set multiTargetOptions = targetSitesService.getMultiTargetOptions(element, element.siteId) %}
                            {% if multiTargetOptions|length %}
                                <ul>
                                    {% for option in multiTargetOptions %}
                                        {% if option.value == 'all' %}
                                            {% set confirmMessage = (isDraftTranslation ? 'Translate to all sites with Save as draft enabled? This will create several drafts from the same all-site snapshot. Continue only if you will review and apply them one at a time.' : 'Translate to all sites? Confirm your action.')|t('multi-translator') %}
                                        {% else %}
                                            {% set confirmMessage = (isDraftTranslation ? 'Translate to {target} with Save as draft enabled? This will create several drafts from the same all-site snapshot. Continue only if you will review and apply them one at a time.' : 'Translate to {target}? Confirm your action.')|t('multi-translator', {target: option.label}) %}
                                        {% endif %}
                                        <li>
                                            <a href="#"
                                           data-multi-translator-translate="{{ {
                                                'elementId': element.canonicalId,
                                                'elementType': className(element),
                                                'sourceSiteId': element.siteId,
                                                'targetSiteId': option.value
                                            }|json_encode }}"
                                               title="{{ option.sites|map(site => site.name)|join(', ') }}"
                                               data-multi-translator-confirm="{{ confirmMessage }}"
                                            >
                                                <strong>{{ option.label }}</strong>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                                <hr>
                            {% endif %}
                            <ul>
                                {% for site in targetSitesService.getAvailableTargetSites(element) %}
                                    <li>
                                        <a class=""
                                           href="#"
                                           data-multi-translator-translate="{{ {
                                               'elementId': element.canonicalId,
                                               'elementType': className(element),
                                               'sourceSiteId': element.siteId,
                                               'targetSiteId': site.id
                                           }|json_encode }}">
                                            {{ site.name }} ({{ site.locale }})
                                            {%- if element.siteId == site.id %} {{ '(self)'|t('multi-translator') }}{% endif %}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if settings.translationDirectionButtons in ['toThis', 'both'] %}
                {% if not targetSitesService.isTargetEnabled(element.site) %}
                    <div class="field" style="border-block-start-width: 2px;">
                        <div class="heading">
                            {{ 'Translating to this site is disabled in the settings.'|t('multi-translator') }}
                        </div>
                    </div>
                {% elseif existingSiteIds|length > 1 %}
                    <div class="field">
                        <div class="heading">
                            {{ 'Translate from:'|t('multi-translator') }}
                        </div>
                        <div class="input">
                            <button type="button" class="btn menubtn" aria-label="{{ 'Translate'|t('multi-translator') }}">{{ 'select source'|t('multi-translator') }}</button>
                            <div class="menu">
                                <ul>
                                    {% for site in sites %}
                                        {% if site.id in existingSiteIds and currentUser.can('editSite:'~site.uid) %}
                                            <li>
                                                <a class=""
                                                   href="#"
                                                   data-multi-translator-translate="{{ {
                                                       'elementId': element.canonicalId,
                                                       'elementType': className(element),
                                                       'sourceSiteId': site.id,
                                                       'targetSiteId': element.siteId
                                                   }|json_encode }}">
                                                    {{ site.name }} ({{ site.locale }})
                                                    {%- if element.siteId == site.id %} {{ '(self)'|t('multi-translator') }}{% endif %}
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <div class="heading">
                            {{ 'to'|t('multi-translator') }}
                        </div>
                        <div class="input">
                            <label>{{ currentDescription }}</label>
                        </div>
                    </div>
                {% else %}
                    <div class="field" style="border-block-start-width: 2px;">
                        <div class="heading">
                            {{ 'This entry has no other translations yet.'|t('multi-translator') }}
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            <div class="field" style="border-block-start-width: 2px;">
                <div class="input">
                    <div class="heading">
                        <a href="{{ url('multi-translator/translate/review', {
                            'elementId': element.canonicalId,
                            'elementType': className(element),
                            'sourceSiteId': element.siteId,
                        }) }}">
                            <span aria-hidden="true" data-icon="gear"></span>
                            {{ 'More options...'|t('multi-translator') }}
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </fieldset>
{% endif %}
