{% extends "_layouts/cp" %}

{% set title = glossary.id ? 'Edit glossary'|t('multi-translator') : 'New glossary'|t('multi-translator') %}
{% set selectedSubnavItem = 'glossaries' %}

{% set crumbs = [
    { label: 'Multi Translator'|t('multi-translator'), url: url('multi-translator') },
    { label: 'Glossaries'|t('multi-translator'), url: url('multi-translator/glossaries') }
] %}

{% set supportedLanguages = [
    {value: '', label: '- select language -'|t('multi-translator')},
    {value: 'ar', label: 'Arabic (AR)'|t('multi-translator')},
    {value: 'bg', label: 'Bulgarian (BG)'|t('multi-translator')},
    {value: 'cs', label: 'Czech (CS)'|t('multi-translator')},
    {value: 'da', label: 'Danish (DA)'|t('multi-translator')},
    {value: 'de', label: 'German (DE)'|t('multi-translator')},
    {value: 'el', label: 'Greek (EL)'|t('multi-translator')},
    {value: 'en', label: 'English (EN)'|t('multi-translator')},
    {value: 'es', label: 'Spanish (ES)'|t('multi-translator')},
    {value: 'et', label: 'Estonian (ET)'|t('multi-translator')},
    {value: 'fi', label: 'Finnish (FI)'|t('multi-translator')},
    {value: 'fr', label: 'French (FR)'|t('multi-translator')},
    {value: 'he', label: 'Hebrew (HE)'|t('multi-translator')},
    {value: 'hu', label: 'Hungarian (HU)'|t('multi-translator')},
    {value: 'id', label: 'Indonesian (ID)'|t('multi-translator')},
    {value: 'it', label: 'Italian (IT)'|t('multi-translator')},
    {value: 'ja', label: 'Japanese (JA)'|t('multi-translator')},
    {value: 'ko', label: 'Korean (KO)'|t('multi-translator')},
    {value: 'lt', label: 'Lithuanian (LT)'|t('multi-translator')},
    {value: 'lv', label: 'Latvian (LV)'|t('multi-translator')},
    {value: 'nb', label: 'Norwegian Bokmål (NB)'|t('multi-translator')},
    {value: 'nl', label: 'Dutch (NL)'|t('multi-translator')},
    {value: 'pl', label: 'Polish (PL)'|t('multi-translator')},
    {value: 'pt', label: 'Portuguese (PT)'|t('multi-translator')},
    {value: 'ro', label: 'Romanian (RO)'|t('multi-translator')},
    {value: 'ru', label: 'Russian (RU)'|t('multi-translator')},
    {value: 'sk', label: 'Slovak (SK)'|t('multi-translator')},
    {value: 'sl', label: 'Slovenian (SL)'|t('multi-translator')},
    {value: 'sv', label: 'Swedish (SV)'|t('multi-translator')},
    {value: 'th', label: 'Thai (TH)'|t('multi-translator')},
    {value: 'tr', label: 'Turkish (TR)'|t('multi-translator')},
    {value: 'uk', label: 'Ukrainian (UK)'|t('multi-translator')},
    {value: 'vi', label: 'Vietnamese (VI)'|t('multi-translator')},
    {value: 'zh', label: 'Chinese (ZH)'|t('multi-translator')}
] %}

{% import '_includes/forms.twig' as forms %}

{% block content %}
    <div class="main">
        <form method="post">
            {{ actionInput('multi-translator/glossaries/save') }}
            {{ csrfInput() }}
            {{ hiddenInput('id', glossary.id) }}

            <fieldset>
                {{ forms.textfield({
                    label: 'Name'|t('multi-translator'),
                    name: 'name',
                    value: glossary.name,
                    errors: glossary.getErrors('name')
                }) }}
                {{ forms.selectfield({
                    label: 'Source Language'|t('multi-translator'),
                    name: 'sourceLanguage',
                    value: glossary.sourceLanguage,
                    options: supportedLanguages,
                    disabled: (glossary.id is not empty),
                    errors: glossary.getErrors('sourceLanguage')
                }) }}
                {{ forms.selectfield({
                    label: 'Target Language'|t('multi-translator'),
                    name: 'targetLanguage',
                    value: glossary.targetLanguage,
                    options: supportedLanguages,
                    disabled: (glossary.id is not empty),
                    errors: glossary.getErrors('targetLanguage')
                }) }}
                {% if glossary.id is not empty %}
                    {{ hiddenInput('sourceLanguage', glossary.sourceLanguage) }}
                    {{ hiddenInput('targetLanguage', glossary.targetLanguage) }}
                {% endif %}
            </fieldset>

            <fieldset>
                {{ forms.editableTableField({
                    label: "Content"|t('multi-translator'),
                    name: "rows",
                    id: "rows",
                    cols: {
                        'source': {
                            type: 'singleline',
                            heading: "Source Text"|t('multi-translator'),
                            rows: 1
                        },
                        'target': {
                            type: 'singleline',
                            heading: "Target Text"|t('multi-translator'),
                            rows: 1
                        },
                    },
                    rows: glossary.rows,
                    allowAdd: true,
                    allowDelete: true,
                    allowReorder: true,
                    addRowLabel: 'Add a row'|t('multi-translator'),
                    errors: glossary.getErrors('rows')
                })|spaceless }}
            </fieldset>

            <button type="submit" class="btn submit">{{ 'Save'|t('multi-translator') }}</button>
        </form>
    </div>
{% endblock %}
