{% requirePermission 'multiTranslateSettings' %}
{% extends "_layouts/cp" %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'Multi Translator'|t('multi-translator') %}
{% set selectedSubnavItem = 'settings' %}

{% set crumbs = [
    { label: 'Multi Translator'|t('multi-translator'), url: url('multi-translator') },
] %}

{% set providerSettings = craft.multiTranslator.providerSettings %}
{% set apiServices = craft.multiTranslator.apiServices %}

{% block content %}
    <form method="post" data-saveshortcut>
        {% namespace "settings" %}
            <fieldset>
                <legend>
                    <h2>{{ 'API Provider'|t('multi-translator') }}</h2>
                </legend>

                {{ forms.selectField({
                    label: 'Provider'|t('multi-translator'),
                    instructions: '',
                    name: 'translationProvider',
                    value: providerSettings.translationProvider ?? 'deepl',
                    options: apiServices|map(s => {value: s.handle, label: s.displayName})|values,
                    toggle: true,
                    targetPrefix: 'translation-provider-'
                }) }}
            </fieldset>
        {% endnamespace %}

        {% for handle, service in apiServices %}
            {% if service.settingsTemplatePath %}
                <fieldset id="settings-translation-provider-{{ handle }}"{% if providerSettings.translationProvider != handle %} class="hidden"{% endif %}>
                    <legend>
                        <h2>{{ service.displayName }}</h2>
                    </legend>

                    {% namespace "settings[providers][#{handle}]" %}
                        {{ include(service.settingsTemplatePath, service.settingsTemplateVariables) }}
                    {% endnamespace %}
                </fieldset>
            {% endif %}
        {% endfor %}

        <hr>

        {% namespace 'settings' %}
            <fieldset>
                <legend>
                    <h2>{{ 'General Options'|t('multi-translator') }}</h2>
                </legend>

                {{ forms.selectField({
                    label: "Translate buttons direction"|t('multi-translator'),
                    instructions: "Select direction 'to target' or 'from source', in the sidebar actions of entry detail view."|t('multi-translator'),
                    id: "translationDirectionButtons",
                    name: "translationDirectionButtons",
                    value: providerSettings.translationDirectionButtons,
                    options: [
                        {'label': 'From current entry to <other sites>'|t('multi-translator'), 'value': 'fromThis'},
                        {'label': 'From <other sites> to current entry'|t('multi-translator'), 'value': 'toThis'},
                        {'label': 'Both (might be confusing)'|t('multi-translator'), 'value': 'both'},
                    ],
                    errors: providerSettings.getErrors("translationDirectionButtons"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Save as draft"|t('multi-translator'),
                    instructions: "Always create a new draft when translating entries."|t('multi-translator'),
                    id: "saveAsDraft",
                    name: "saveAsDraft",
                    on: providerSettings.saveAsDraft,
                    errors: providerSettings.getErrors("saveAsDraft"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Reset slug"|t('multi-translator'),
                    instructions: "Reset slug after translation, in order for a new slug to be generated from the translated title."|t('multi-translator'),
                    id: "resetSlug",
                    name: "resetSlug",
                    on: providerSettings.resetSlug,
                    errors: providerSettings.getErrors("resetSlug"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Detect Source Language"|t('multi-translator'),
                    instructions: "Don't send the source language to the API and let Deepl/Google detect the source language."|t('multi-translator'),
                    id: "detectSourceLanguage",
                    name: "detectSourceLanguage",
                    on: providerSettings.detectSourceLanguage,
                    errors: providerSettings.getErrors("detectSourceLanguage"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Update internal links"|t('multi-translator'),
                    instructions: "Update internal links in CKeditor and point them to target site element."|t('multi-translator'),
                    id: "updateInternalLinks",
                    name: "updateInternalLinks",
                    on: providerSettings.updateInternalLinks,
                    errors: providerSettings.getErrors("updateInternalLinks"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Translated CKeditor nested entries"|t('multi-translator'),
                    instructions: "Find and process nested Entries inside CKeditor value."|t('multi-translator'),
                    id: "processNestedEntries",
                    name: "processNestedEntries",
                    on: providerSettings.processNestedEntries,
                    errors: providerSettings.getErrors("processNestedEntries"),
                }) }}

                {{ forms.editableTableField({
                    label: "Disabled fields"|t('multi-translator'),
                    instructions: 'Disable field handles and ignore them in the translation'|t('multi-translator'),
                    name: "disabledFields",
                    id: "disabledFields",
                    cols: {
                        'handle': {
                            type: 'singleline',
                            heading: "Field handle"|t('multi-translator'),
                            rows: 1
                        },
                    },
                    rows: providerSettings.disabledFields,
                    allowAdd: true,
                    allowDelete: true,
                    allowReorder: true,
                    addRowLabel: 'Add a field'|t('multi-translator'),
                    errors: providerSettings.getErrors('disabledFields'),
                    required: false
                })|spaceless }}

                {{ forms.lightswitchField({
                    label: "Translate disabled Commerce Variants"|t('multi-translator'),
                    instructions: "Query and translate disabled variants of Commerce Products."|t('multi-translator'),
                    id: "translateDisabledVariants",
                    name: "translateDisabledVariants",
                    on: providerSettings.translateDisabledVariants,
                    errors: providerSettings.getErrors("translateDisabledVariants"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Translate disabled Matrix Elements"|t('multi-translator'),
                    instructions: "Query and translate disabled Matrix Elements inside fields"|t('multi-translator'),
                    id: "translateDisabledMatrixElements",
                    name: "translateDisabledMatrixElements",
                    on: providerSettings.translateDisabledMatrixElements,
                    errors: providerSettings.getErrors("translateDisabledMatrixElements"),
                }) }}
            </fieldset>
        {% endnamespace %}

        <hr>

        <fieldset>
            {{ csrfInput() }}
            {{ actionInput('multi-translator/provider-settings/update') }}
            <button class="btn submit">{{ 'Save'|t('multi-translator') }}</button>
        </fieldset>
    </form>
{% endblock %}
