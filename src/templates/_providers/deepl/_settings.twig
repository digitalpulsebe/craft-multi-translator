{% import '_includes/forms.twig' as forms %}

{{ forms.autosuggestfield({
    label: 'DeepL API Key'|t('multi-translator'),
    name: 'deeplApiKey',
    instructions: 'Copy the API Key from your DeepL [account settings page](https://www.deepl.com/account/summary)'|t('multi-translator'),
    suggestEnvVars: true,
    value: settings.deeplApiKey ?? '',
}) }}

{{ forms.selectField({
    label: "DeepL Language Model"|t('multi-translator'),
    instructions: "Specifies which DeepL model should be used for translation. [See docs](https://support.deepl.com/hc/en-us/articles/14241705319580-About-DeepL-language-models)"|t('multi-translator'),
    id: "deeplModelType",
    name: "deeplModelType",
    value: settings.deeplModelType ?? 'latency_optimized',
    options: [
        {'label': 'Classic (latency optimized)'|t('multi-translator'), 'value': 'latency_optimized'},
        {'label': 'Next-generation (improved quality)'|t('multi-translator'), 'value': 'quality_optimized'},
        {'label': 'Prefer Next-generation (fallback to classic for non-supported language pairs)'|t('multi-translator'), 'value': 'prefer_quality_optimized'},
    ],
}) }}

{{ forms.lightswitchField({
    label: "Preserve formatting"|t('multi-translator'),
    instructions: "Controls automatic-formatting-correction. Set to true to prevent automatic-correction of formatting. [See docs](https://github.com/DeepLcom/deepl-php#text-translation-options)"|t('multi-translator'),
    id: "deeplPreserveFormatting",
    name: "deeplPreserveFormatting",
    on: settings.deeplPreserveFormatting ?? false,
}) }}

{{ forms.selectField({
    label: "Formality"|t('multi-translator'),
    instructions: "Controls whether translations should lean toward informal or formal language. This option is only available for some target languages. [See docs](https://github.com/DeepLcom/deepl-php#text-translation-options)"|t('multi-translator'),
    id: "deeplFormality",
    name: "deeplFormality",
    value: settings.deeplFormality ?? 'default',
    options: [
        {'label': 'Default'|t('multi-translator'), 'value': 'default'},
        {'label': 'Less formal'|t('multi-translator'), 'value': 'prefer_less'},
        {'label': 'More formal'|t('multi-translator'), 'value': 'prefer_more'},
    ],
}) }}

{{ forms.selectField({
    label: "Default English"|t('multi-translator'),
    instructions: "Default English for translating to English."|t('multi-translator'),
    id: "defaultEnglish",
    name: "defaultEnglish",
    value: settings.defaultEnglish ?? 'en-US',
    options: [
        {'label': 'American English (en-US)'|t('multi-translator'), 'value': 'en-US'},
        {'label': 'British English (en-GB)'|t('multi-translator'), 'value': 'en-GB'},
    ],
}) }}
