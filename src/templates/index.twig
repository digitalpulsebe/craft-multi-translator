{% extends "_layouts/cp" %}

{% set title = 'Multi Translator'|t('multi-translator') %}

{% set crumbs = [
    { label: 'Multi Translator'|t('multi-translator'), url: url('multi-translator') },
] %}

{% set settings = craft.multiTranslator.providerSettings %}
{% set provider = craft.multiTranslator.provider %}

{% block content %}
    <div class="main">
        <h2>{{ 'Provider'|t('multi-translator') }}</h2>
        <p>
            {% if provider.isConnected %}
                <span class="status live" role="img" aria-label="{{ 'Status: Connected'|t('multi-translator') }}"></span>
            {% else %}
                <span class="status" role="img" aria-label="{{ 'Status: Not Connected'|t('multi-translator') }}"></span>
            {% endif %}
            {{ provider.displayName }}
        </p>

        {% if settings.translationProvider == 'deepl' and provider.isConnected %}
            {% set usage = provider.usage %}

            {% if usage %}
                <p>
                    {% if usage.character %}
                        {{ 'Usage:'|t('multi-translator') }}
                        {{ usage.character.count|number_format(0, '.', ',') }}
                        / {{ usage.character.limit|number_format(0, '.', ',') }}
                    {% endif %}
                </p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
