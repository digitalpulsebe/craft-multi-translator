{% requirePermission 'multiTranslateContent' %}
{% extends "_layouts/cp" %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'Translate Entry'|t('multi-translator') %}

{% set crumbs = [
    { label: 'Multi Translator'|t('multi-translator'), url: url('multi-translator') },
] %}

{% set settings = craft.multiTranslator.providerSettings %}

{% block content %}
    <h2>{{ 'Elements'|t('multi-translator') }}</h2>
    <div class="main">
        <div class="tableview">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Title'|t('multi-translator') }}</th>
                        <th>{{ element is instance of('craft\\elements\\Asset') ? 'Volume'|t('multi-translator') : (element is instance of('craft\\commerce\\elements\\Product') ? 'Product Type'|t('multi-translator') : 'Section'|t('multi-translator')) }}</th>
                        <th>{{ 'Propagation method'|t('multi-translator') }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            {{ elementChip(element, {
                                siteId: sourceSiteId,
                                size: 'small',
                            }) }}
                        </td>
                        <td>{{ element.section.name ?? element.volume.name ?? element.type.name ?? '' }}</td>
                        <td>{{ element.section.propagationMethod.value ?? element.volume.altTranslationMethod ?? element.type.propagationMethod.value ?? '' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <hr>

    {% set elementHelper = craft.multiTranslator.getElementHelper() %}

    {% set existingSiteIds = elementHelper.siteStatusesForElement(element)|keys %}
    {% set supportedSiteIds = elementHelper.supportedSitesForElement(element, true)|map(site => site.siteId) %}
    {% set sites = craft.app.sites.allSites %}

    {% set existingSiteOptions = sites|filter(site => (site.id in existingSiteIds and currentUser.can('editSite:'~site.uid)))|map(site => {label: site.name, value: site.id}) %}
    {% set supportedSiteOptions = [{label: '- select target -'|t('multi-translator'), value: ''}] %}
    {% set supportedSiteOptions = supportedSiteOptions
        |merge(sites|filter(site => site.id in supportedSiteIds)
        |filter(site => currentUser.can('editSite:'~site.uid))
        |map(site => {label: site.name, value: site.id})) %}

    <form method="post">
        <fieldset class="flex-fields">
            <legend>
                <h2>{{ 'Source and target'|t('multi-translator') }}</h2>
            </legend>

            {{ forms.selectField({
                label: "Source site"|t('multi-translator'),
                instructions: "Only sites with existing entry are shown"|t('multi-translator'),
                id: "sourceSiteId",
                name: "sourceSiteId",
                value: sourceSiteId,
                options: existingSiteOptions,
                fieldAttributes: {class: 'field width-50'},
                inputAttributes: {required: 1},
                errors: settings.getErrors("sourceSiteId"),
            }) }}

            {{ forms.selectField({
                label: "Target site"|t('multi-translator'),
                instructions: "Only sites enabled for this section are shown"|t('multi-translator'),
                id: "targetSiteId",
                name: "targetSiteId",
                value: null,
                options: supportedSiteOptions,
                fieldAttributes: {class: 'field width-50'},
                inputAttributes: {required: 1},
                errors: settings.getErrors("targetSiteId"),
            }) }}
        </fieldset>

        {% namespace 'config' %}
        <fieldset>
                <legend>
                    <h2>{{ 'Ignore Fields'|t('multi-translator') }}</h2>
                </legend>

                {% set fields = element.fieldLayout.customFields %}
                {% set fieldsOptions = [{label: "Title"|t('multi-translator'), value: "title"}]
                    |merge(fields|map(field => {label: "#{field.name} (#{field.handle})", value: field.handle})) %}

                {{ forms.checkboxGroupField({
                    label: "Disabled fields"|t('multi-translator'),
                    instructions: "Select the fields to ignore"|t('multi-translator'),
                    id: "disabledFields",
                    name: "disabledFields",
                    options: fieldsOptions,
                }) }}
            </fieldset>
            <fieldset>
                <legend>
                    <h2>{{ 'Override settings once'|t('multi-translator') }}</h2>
                </legend>

                {{ forms.lightswitchField({
                    label: "Save as draft"|t('multi-translator'),
                    instructions: "Always create a new draft when translating entries"|t('multi-translator'),
                    id: "saveAsDraft",
                    name: "saveAsDraft",
                    on: settings.saveAsDraft,
                    errors: settings.getErrors("saveAsDraft"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Reset slug"|t('multi-translator'),
                    instructions: "Reset slug after translation, in order for a new slug to be generated from the translated title."|t('multi-translator'),
                    id: "resetSlug",
                    name: "resetSlug",
                    on: settings.resetSlug,
                    errors: settings.getErrors("resetSlug"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Detect Source Language"|t('multi-translator'),
                    instructions: "Don't send the source language to the API and let Deepl/Google detect the source language."|t('multi-translator'),
                    id: "detectSourceLanguage",
                    name: "detectSourceLanguage",
                    on: settings.detectSourceLanguage,
                    errors: settings.getErrors("detectSourceLanguage"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Update internal links"|t('multi-translator'),
                    instructions: "Update internal links in CKeditor and point them to target site element."|t('multi-translator'),
                    id: "updateInternalLinks",
                    name: "updateInternalLinks",
                    on: settings.updateInternalLinks,
                    errors: settings.getErrors("updateInternalLinks"),
                }) }}

                {{ forms.lightswitchField({
                    label: "Translated CKeditor nested entries"|t('multi-translator'),
                    instructions: "Find and process nested Entries inside CKeditor value"|t('multi-translator'),
                    id: "processNestedEntries",
                    name: "processNestedEntries",
                    on: settings.processNestedEntries,
                    errors: settings.getErrors("processNestedEntries"),
                }) }}
            </fieldset>
        {% endnamespace %}

        <hr>

        <fieldset>
            {{ csrfInput() }}
            {{ hiddenInput('elementId', element.id) }}
            {{ hiddenInput('elementType', elementType) }}
            {{ actionInput('multi-translator/translate/confirm') }}
            <button class="btn submit">{{ 'Confirm'|t('multi-translator') }}</button>
        </fieldset>
    </form>
{% endblock %}
