{% requirePermission 'multiTranslateContent' %}
{% import '_includes/forms.twig' as forms %}

{% set settings = craft.multiTranslator.providerSettings %}

<form method="POST">
    {{ actionInput('multi-translator/block/translate') }}
    {{ hiddenInput('blockId', element.id) }}
    {{ hiddenInput('sourceSiteId', sourceSiteId) }}
    {{ csrfInput() }}

    <header class="header">
        <h1>{{ 'Translate block'|t('multi-translator') }}</h1>
    </header>

    <div class="body">
        {{ forms.selectField({
            label: 'Target site'|t('multi-translator'),
            id: "translationTarget-${elementId}",
            name: 'targetSiteId',
            options: craft.multiTranslator.targetSites.getTargetSelectOptions(element, sourceSiteId, false, false),
            inputAttributes: {required: 1},
        }) }}
    </div>

    <footer class="footer">
        <div class="buttons right">
            <button type="submit" class="btn submit submitTranslation">{{ 'Start translation'|t('multi-translator') }}</button>
        </div>
    </footer>
</form>